# ==============================================================================
# CampusFood Environment Variables Configuration Template
# ==============================================================================

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional development-only meal preview (Breakfast, Lunch, or Dinner).
# Set in .env.local and restart Vite to preview a meal outside its normal window.
# VITE_DEMO_MEAL=Lunch

# Optional: Cafeteria Payment Accounts (displayed on the student subscription screen)
# If omitted, safe fallback defaults are used.
VITE_CAFETERIA_CBE_ACCOUNT=1000690418917
VITE_CAFETERIA_CBE_NAME=CampusFood Finance (CBE)
VITE_CAFETERIA_TELEBIRR_PHONE=0950271983
VITE_CAFETERIA_TELEBIRR_NAME=CampusFood Finance